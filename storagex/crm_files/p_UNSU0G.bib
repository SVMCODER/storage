	keywords = {Decision making; Domestic appliances; Risk assessment; Supply chains; Barrier; Coping strategies; Creatives; DEMATEL; Globalisation; Manufacturing business; Manufacturing organizations; Performance; Supplier collaboration; TISM; Sustainable development},
