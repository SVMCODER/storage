	keywords = {Agile manufacturing systems; Decision support systems; Inventory control; K-means clustering; Learning systems; Logistics; Neural networks; Railroad transportation; Railroads; Repair; Clusterings; Data driven decision; Decision support framework; Decision supports; Demand forecasting; Demand planning; Inventory planning; Machine-learning; Maintenance repair and operations; Railway; Industry 4.0},
