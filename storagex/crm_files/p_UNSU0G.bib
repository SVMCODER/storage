	title = {Political Polarization on Social Media and Client Retention in Business-to-Business Firms: An Empirical Study},
	year = {2026},
	journal = {Journal of Global Information Management},
	volume = {34},
	number = {1},
	pages = {},
	doi = {10.4018/JGIM.411203},
	url = {https://www.scopus.com/pages/publications/105044572320?origin=resultslist},
	affiliations = {Excelia Business School, France; Institute of Management Technology, Ghaziabad, India; North South University, Bangladesh},
	abstract = {In a climate of increasing political polarization and digital visibility, business-to-business (B2B; transactions or services between businesses rather than between a business and individual consumer) firms face growing challenges in managing client retention. This study investigates how political polarization on social media, particularly as perceived by clients regardless of alignment with values, erodes trust and threatens long-term B2B relationships. Drawing on social exchange theory and signaling theory, this study develops and empirically tests a model linking political polarization, trust erosion, and client retention, with social media virality as a moderating factor. Data were collected from 1,000 B2B firms across multiple industries and regions and analyzed using structural equation modeling. Results show that perceived political polarization negatively affects client retention, primarily through trust erosion. In addition, social media virality weakens the positive association between political polarization and trust erosion, suggesting that highly visible content may reduce the marginal impact of polarized signals in complex information environments. The study contributes to the emerging discussion on political risk in B2B marketing and offers actionable insights for navigating ideologically sensitive environments. This article published as an Open Access article distributed under the terms of the Creative Commons Attribution License (http://creativecommons.org/licenses/by/4.0/) which permits unrestricted use, distribution, and production in any medium, provided the author of the original work and original publication source are properly credited.},
	author_keywords = {B2B Firms; Client Retention; Empirical Study; Political Polarization; Social Media},
	keywords = {Polarization; Signal theory; B2B firm; Business-to-business; Client retention; Empirical studies; Political polarization; Signaling theory; Social exchange theory; Social media; Theory theories; Trust erosions; Social networking (online)},
	correspondence_address = {S. Bag; Excelia Business School, France; email: surajit.bag@gmail.com},
	publisher = {IGI Global},
