	author = {Mohapatra, Biswajit and Tripathy, Sushanta and Singhal, Deepak and Saha, Rajnandini},
	title = {Significance of digital technology in manufacturing sectors: Examination of key factors during Covid-19},
	year = {2022},
	journal = {Research in Transportation Economics},
	volume = {93},
