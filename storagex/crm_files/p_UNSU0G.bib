	title = {Decarbonised closed-loop supply chains resilience: examining the impact of COVID-19 toward risk mitigation by a fuzzy multi-layer decision-making framework},
	year = {2026},
	journal = {Annals of Operations Research},
	volume = {359},
	number = {1},
