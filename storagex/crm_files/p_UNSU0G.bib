@ARTICLE{Goswami2025110,
	author = {Goswami, Shankha Shubhra and Mondal, Surajit and Sarkar, Shouvik and Gupta, Krishna Kumar and Sahoo, Sushil Kumar and Halder, Rohit},
	title = {Artificial Intelligence-Enabled Supply Chain Management: Unlocking New Opportunities and Challenges},
	year = {2025},
