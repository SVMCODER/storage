	url = {https://www.scopus.com/pages/publications/105019246705?origin=resultslist},
	affiliations = {Department of Management Sciences, Indian Institute of Technology Kanpur, Kanpur, India},
	abstract = {Industry 5.0 provides a promising approach to the textile sector to tackle pressing sustainability challenges, including greenhouse gas emissions and inefficient production practices. Despite its potential, Industry 5.0 implementation remains in its early stages in the textile sector. This study identifies key criteria and enablers essential for Industry 5.0 implementation in the textile sector. Through an extensive literature review and validation by 16 Indian textile experts, 8 criteria and 15 enablers were analyzed. An integrated spherical fuzzy-based Stepwise Weight Assessment Ratio Analysis (SFS-SWARA) and Additive Ratio Assessment (SFS-ARAS) approach was used for analysis. Findings highlight Corporate Social Responsibility, Lean Approach, and Sustainable Thinking as crucial criteria, while Internet of Everything, Cyber-Physical Production Systems, and Collaborative Robots serve as primary enablers. Sensitivity analysis supports the robustness of these results. By providing actionable insights, this study equips textile organizations with knowledge to strategically embrace Industry 5.0, driving sustainable transformation in an evolving industrial landscape. © 2025 ERP Environment and John Wiley & Sons Ltd.},
