@ARTICLE{Reddy2025321,
	author = {Reddy, D. Ramesh and Velmurugan, R. and Govindaraj, Manoj and Sebastian, Alycia and Mohamed, Aezeden and Vincent, G. Stanley},
	title = {Real-Time ESG Compliance Scoring Engine Using IoT–AI Synergy for Green Investment Management},
	year = {2025},
	journal = {International Academic Journal of Science and Engineering},
	volume = {12},
	number = {4},
	pages = {321 - 330},
	doi = {10.71086/IAJSE/V12I4/IAJSE1299},
	url = {https://www.scopus.com/pages/publications/105036563806?origin=resultslist},
	affiliations = {Department of Electronics and Communication Engineering, Vallurupalli Nageswara Rao Vignana Jyothi Institute of Engineering and Technology, Telangana, Hyderabad, India; Department of Commerce, Karpagam Academy of Higher Education Coimbatore, Tamil Nadu, India; Department of Management Studies, Vel Tech Rangarajan Dr Sagunthala R&D Institute of Science and Technology, Avadi, Tamil Nadu, Chennai, India; Information Technology Department, Al Zahra College for Women, Oman; Faculty of Engineering, PNG University of Technology, Morobe Province, Lae, Papua New Guinea; School of Management Studies, Mount Carmel College Autonomous, Karnataka, Bengaluru, India},
	abstract = {Environmental, Social and Governance (ESG) compliance has now become a crucial component of sustainable investment decision-making; however, existing mechanisms for scoring ESG adhere to periodic disclosures, manual reporting and retrospective audits, which do not provide real-time transparency and precision in operations. These limitations result in loss of investor confidence and, therefore, delay of responsive green investment actions. To mitigate this data gap, this study introduces the Green Sense Engine (GSE) as a real-time ESG compliance score framework that leverages Internet of Things (IoT) sensor networks, Artificial Intelligence (AI), federated learning, reinforcement learning, and blockchain-enabled transparency. The system is constantly collecting environmental and operational metrics like energy usage, carbon emissions and workplace safety metrics using the distributed IoT sensors, and the edge-based artificial intelligence models are running for anomaly detection and feature extraction in real-time. A federated learning architecture enables privacy-preserving joint model training across multiple enterprises without centralised data sharing, and reinforcement learning dynamically adjusts the weight parameters of ESG in response to changing regulations and operations. Blockchain-based smart contracts help guarantee the unchangeable, auditable recording of compliance events, thereby improving accountability and building stakeholder trust. Experimental simulations show that data reliability has improved, predictive support for investment decisions is stronger, and update latency has been significantly reduced compared with conventional ESG frameworks. The proposed IoT-AI synergy takes ESG evaluation to the next level, providing a proactive, transparent, and continuously adaptive decision-support mechanism for next-generation green investment management. © 2025, International Academic Institute for Science and Technology. All rights reserved.}