	title = {A framework integrating dynamic capabilities with sustainability-oriented innovation activities in collaborative networks: A systematic literature review; [Framework integrando capacidades dinâmicas com atividades de inovação orientadas para a sustentabilidade em redes colaborativas: Uma revisão sistemática da literatura]; [Framework integrando capacidades dinámicas con actividades de innovación orientadas a la sostenibilidad en redes colaborativas: Una revisión sistemática de la literatura]},
