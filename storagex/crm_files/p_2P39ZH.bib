	author = {Tandon, Anushree and Dhir, Amandeep and Kaur, Puneet and Ogbonnaya, Chidiebere},
	title = {Ethical Sourcing and Decision Making in the Fashion Industry: A Longitudinal Qualitative Examination},
	year = {2025},
	journal = {Journal of Business Ethics},
	volume = {196},
