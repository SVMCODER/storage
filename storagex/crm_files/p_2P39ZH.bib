@ARTICLE{Gao2026,
	author = {Gao, Chang and Peinkofer, Simone T. and Griffis, Stanley E.},
	title = {Are We Delivering What Customers Want? Charting Logistics Service Quality Research—A Process View},
	year = {2026},
	journal = {Journal of Business Logistics},
