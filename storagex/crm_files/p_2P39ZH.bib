@ARTICLE{Duzgun2026363,
	author = {Duzgun, Erkan},
	title = {Drivers of Green Logistics Implementation and Firm Performance: Evidence from Vietnam's Logistics Sector},
	year = {2026},
	journal = {Operations and Supply Chain Management},
	volume = {19},
	number = {2},
	pages = {363 - 380},
	doi = {10.31387/oscm0650526},
	url = {https://www.scopus.com/pages/publications/105045239357?origin=resultslist},
	affiliations = {School of Business, International University, National University HCMC, Viet Nam},
	abstract = {This study investigates the determinants of green logistics implementation and firm performance in Vietnam's freight forwarding industry. Drawing on the Resource-Based View and Institutional Theory, the research examines how green technological capability, environmental orientation, environmental pressure, green collaboration, and firm scale influence green logistics practices and subsequent performance outcomes. Survey data were collected from 286 respondents in logistics firms operating in Vietnam. Partial Least Squares Structural Equation Modeling (PLS-SEM) was employed to test the proposed framework. The results indicate that green technological capability and firm scale significantly enhance green logistics implementation. Environmental orientation also exerts a positive effect on both green logistics implementation and firm performance. In contrast, environmental pressure does not directly influence green logistics implementation but significantly drives green collaboration. Green collaboration, however, does not directly improve firm performance. Green logistics implementation significantly improves firm performance and mediates the effects of environmental orientation, firm scale, and technological capability on performance. These findings extend sustainable supply chain management literature by clarifying the relative importance of internal capabilities, organizational characteristics, and institutional drivers in an emerging market context. The study demonstrates that internal strategic orientation and operational capabilities are more influential than external pressures in promoting effective green logistics implementation. Managerially, the results suggest that logistics firms should prioritize capability development and strategic environmental commitment to enhance performance outcomes. Policymakers can support sustainability transitions by strengthening institutional frameworks while facilitating capability building among logistics firms. © (2026), (Operations and Supply Chain Management Forum). All rights reserved.},
	author_keywords = {Emerging Economy; Environmental Orientation; Firm Performance; Green Logistics Implementation; Logistics Service Providers; Sustainable Logistics; Technological Capability},
