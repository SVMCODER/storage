	keywords = {Australia; Cost benefit analysis; Secondary batteries; Battery systems; Economic optimization; Linear-programming; Photovoltaic/battery systems; Queensland; Self-consumption ratio; Self-sufficiency ratio; Techno-economic optimization; Techno-economics; Technology costs; energy use; optimization; photovoltaic system; solar power; technology adoption; Linear programming},
