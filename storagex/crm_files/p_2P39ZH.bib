@ARTICLE{Wibisono2026175,
	author = {Wibisono, Gunawan and Sumiati and Wijayanti, Risna and Hapsari, Raditha},
	title = {Data analytics capability and sustainable business performance in capital-constrained commercial aviation: Evidence from Indonesia},
	year = {2026},
	journal = {Transport Economics and Management},
	volume = {4},
	pages = {175 - 192},
	doi = {10.1016/j.team.2026.07.003},
	url = {https://www.scopus.com/pages/publications/105046698180?origin=resultslist},
	affiliations = {Department of Management, Faculty of Economics and Business, Universitas Brawijaya, Malang, Indonesia},
	abstract = {Commercial aviation in emerging economies faces fuel volatility, supply-chain disruption, regulatory divergence, and limited capital for physical decarbonization. This study examines whether data analytics capability (DAC) is associated with sustainable business performance (SBP) directly and through supply chain agility (SCA) and supply chain resilience (SCR) among Indonesian commercial air transport operators. Data from a census of all 83 active operators were analyzed using partial least squares structural equation modeling (PLS-SEM) with 10,000 bootstrap resamples. DAC was positively associated with pooled SBP (β=.299). The estimated total DAC–SBP association was β=.662, comprising the direct association and specific indirect associations through SCA, SCR, and the serial SCA–SCR pathway. The serial indirect association was statistically significant but modest (β=.041) and is consistent with, rather than proof of, the proposed structural ordering. Exploratory triple bottom line (TBL) models showed significant SCA associations with economic and social outcomes but not with the single-item environmental fuel-efficiency outcome (β=.128, p=.229). DAC (β=.405) and SCR (β=.315) were positively associated with that environmental outcome. Full measurement invariance was established across large-transport and small-transport operators, and no permutation-based multigroup path differences were significant (p=.091–.799). Fuel-efficiency improvement was the lowest-rated pooled-SBP indicator. The findings provide census-level evidence that DAC, SCA, and SCR are associated with sustainable business performance in this setting; however, establishing causal directionality, objective operational gains, and cost-effectiveness requires longitudinal and operational data validation. © 2026 The Authors},
	author_keywords = {data analytics capability; Indonesian commercial aviation; PLS-SEM; supply chain agility; supply chain resilience; sustainable business performance; triple bottom line},
