@ARTICLE{Palmié2023,
	author = {Palmié, Maximilian and Rüegger, Stephanie and Holzer, Matthias and Oghazi, Pejvak},
	title = {The “golden” voice of “green” employees: The effect of private environmental orientation on suggestions for improvement in firms’ economic value creation},
	year = {2023},
	journal = {Journal of Business Research},
	volume = {156},
	pages = {},
	doi = {10.1016/j.jbusres.2022.113492},
	url = {https://www.scopus.com/pages/publications/85143800642?origin=resultslist},
	affiliations = {Institute of Technology Management, University of St, Gallen, Switzerland; INCAE Business School, Costa Rica; ZF Friedrichshafen, Germany; School of Social Sciences, Södertorn University, Stockholm, Sweden; Hanken School of Economics in Helsinki, Finland},
	abstract = {This study examines whether employees’ private environmental orientation matters for the economic performance of their firms. It argues that employees’ private environmental orientation affects not only their pro-environmental and pro-social behavior (PEPSB) in the workplace but also their inclination to make suggestions for improvements (i.e., their voice behavior). It also contends that their voice behavior is not limited to suggestions rooted in PEPSB but includes suggestions for other economically attractive improvements besides pro-environmental and pro-social improvements. This study further maintains that firms can support the transformation of employees’ private environmental orientation into voice behavior at work by influencing employees’ perception of the firm. Specifically, it posits that an employee's private environmental orientation leads to more suggestions for economically attractive improvements at work, the more she or he perceives the company to emphasize sustainability. An analysis of 283 employees in the hospitality industry provides strong support for our theoretical account. © 2022 The Authors},
