	doi = {10.1016/j.tre.2021.102279},
	url = {https://www.scopus.com/pages/publications/85104937280?origin=resultslist},
	affiliations = {China Institute of FTZ Supply Chain, Shanghai Maritime University, Shanghai, 201306, China; Yonsei Frontier Lab, Yonsei University, Seoul, South Korea; Center for Sustainable Supply Chain Engineering, Department of Technology and Innovation, Danish Institute for Advanced Study, University of Southern Denmark, Campusvej 55, Odense M, Denmark; Département de Génie Mécanique, Université Laval, Québec, Canada},
	abstract = {With new global regulations on supply chains (SCs), sustainable regulation mechanisms have become subject to controversy. The intention is to create and expand green and sustainable supply chains (SSC) to meet environmental and economic standards and to boost one's position in competitive markets. This study examines the resilient sustainable reverse logistics network (RLN) process for end-of-life vehicles (ELVs) in Iran. We pursue both actual and uncertain situations that possess big data characteristics (3 V's) in information between facilities of the proposed reverse logistics (RL), and we consider recycling technology due to its societal impacts. Due to unpredictable environmental and social factors, the various proposed network facilities may not utilize their full capacity, so we also consider situations in which the network facility capacity is disrupted. Our primary objective is to minimize the total cost of the resilient sustainable RLN. For most parameters, finding the best solution through traditional methods is time-consuming and costly. Hence, to enhance decision-making power, the value of model parameters in each scenario is considered. A Cross-Entropy (CE) algorithm with basic scenario concepts is used in robust model optimization. The results demonstrate that changing the scenario situation significantly impacts optimal environmental and social costs. In particular, when the situation is “pessimistic,” environmental impact costs are at their highest levels. Hence, scenario-based modeling of the network is a good approach to implement under uncertainty conditions. On the other hand, results show that cost savings for organizations are achieved through optimal planning of the centers' capacity to save cost, increase services, and ensure effective government response to cost-effective and instrumental market competition. © 2021},
	author_keywords = {Big data; Cross-entropy algorithm; ELVs; Resilient sustainable reverse logistics network; Robust optimization},
	keywords = {Iran; Big data; Commerce; Competition; Cost effectiveness; Economic and social effects; Entropy; Environmental impact; Optimization; Supply chains; Sustainable development; Uncertainty analysis; Case-studies; Cross entropy; Cross-entropy algorithm; End-of-Life Vehicles; Entropy algorithms; Network design; Resilient sustainable reverse logistic network; Reverse logistic networks; Robust network; Robust optimization; algorithm; competitiveness; data management; network design; optimization; public transport; supply chain management; sustainability; Decision making},
