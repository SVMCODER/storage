	keywords = {Decision making; Decision theory; Ecodesign; Product design; Sustainable development; Chemical products; Corporate-sustainability; Early stage designs; Multi-criteria decision analysis; Multicriteria analysis; Multicriterion analysis; Organizational perspectives; Process systems engineering; Product-process design; Sustainability assessment; Process design},
