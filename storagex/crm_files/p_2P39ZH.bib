@ARTICLE{Primadasa2025,
	author = {Primadasa, Rangga and Kusrini, Elisa and Mansur, Agus and Masudin, Ilyas},
	title = {Enhancing SME supply chain sustainability through organizational ambidexterity and supply chain agility using the MOORA-ISM-MICMAC framework},
	year = {2025},
	journal = {Sustainable Futures},
	volume = {10},
	pages = {},
	doi = {10.1016/j.sftr.2025.101373},
	url = {https://www.scopus.com/pages/publications/105016814051?origin=resultslist},
	affiliations = {Industrial Engineering Department, Universitas Islam Indonesia, Jl. Kaliurang Km. 14.5, Yogyakarta, Indonesia; Industrial Engineering Department, Universitas Muria Kudus, Jl. Lkr. Utara, Kudus, Indonesia; Industrial Engineering Department, Universitas Muhammadiyah Malang, Jl. Raya Tlogomas, 246, Malang, Indonesia},
	abstract = {Small and medium enterprises (SMEs) are highly vulnerable to global disruptions such as economic crises, pandemics, and climate-related shocks, which undermine supply chain sustainability. Prior studies often treat ambidexterity, agility, and sustainability in isolation, creating a gap in understanding their integrated role in resilience. This study addresses this gap by modeling their interrelationships. A multi-method analytical design was applied, integrating Multi-Objective Optimization on the basis of Ratio Analysis (MOORA), Interpretative Structural Modeling (ISM), and Matrix of Cross Impact Multiplications Applied to a Classification (MICMAC). A purposive sample of seven experts, including academics and SME practitioners in Indonesia with over five years of experience, participated in two rounds of structured evaluation. Twenty-four indicators across ambidexterity, agility, and sustainable supply chain dimensions were identified, validated, and analyzed. MOORA prioritized the indicators, ISM structured them into a hierarchy, and MICMAC classified them by driving and dependence power. Results show that employee skill development and quality management system integration have the strongest driving power, while profit and sales growth, along with product quality, are highly dependent. All 24 indicators were retained in the final framework, organized into a 14-level ISM hierarchy and four MICMAC clusters. Theoretically, this study extends dynamic capability theory by linking ambidexterity and agility to SME resilience, while practically offering managers a structured tool to balance innovation, responsiveness, and sustainability. © 2025 The Author(s)},
	author_keywords = {Ambidexterity; ISM; MICMAC; MOORA; Supply chain agility; Sustainable SCM},
	correspondence_address = {I. Masudin; Industrial Engineering Department, Universitas Muhammadiyah Malang, Malang, Jl. Raya Tlogomas, 246, Indonesia; email: masudin@umm.ac.id},
