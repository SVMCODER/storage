@ARTICLE{Sangosanya20251004,
	author = {Sangosanya, Taofeek Adeyemi and Salleh, Sri Sarah Maznah Mohd and Saraih, Ummi Naiemah},
	title = {Pathways to digital entrepreneurship adoption among Malaysian SMEs: Analysing the determinants and technology readiness dynamics},
	year = {2025},
	journal = {Journal of International Entrepreneurship},
	volume = {23},
	number = {4},
	pages = {1004 - 1038},
	doi = {10.1007/s10843-025-00403-x},
	url = {https://www.scopus.com/pages/publications/105016826191?origin=resultslist},
	affiliations = {Faculty of Business and Communication, Universiti Malaysia Perlis, Perlis, Malaysia; Department of Business Management, Daffodil International University, Dhaka, Bangladesh},
	abstract = {This study explores the key factors influencing digital entrepreneurship (DE) adoption among Malaysian SMEs within the framework of technology, organisation, and environment (TOE), with a particular focus on how technology readiness moderates these effects. Using a cross-sectional survey of 307 SME owners and managers, the research employs SPSS and PLS-SEM to analyse the data and test hypotheses. The results reveal that relative advantage, compatibility, complexity, employee knowledge, and competitive pressure significantly drive digital transformation efforts. Interestingly, organisation size and government support do not exert substantial influence. The role of technology readiness, assessed through the Technology Readiness Index (TRI), emerged as a critical moderator: traits like optimism and innovativeness amplify positive relationships between compatibility, organisation size, and DE adoption, while discomfort and insecurity significantly affect how perceived relative advantages, complexity, and government support impact this process. These findings contribute empirical evidence from the Malaysian context, underscoring the importance of technology readiness in shaping digital transformation in SMEs. The insights gained provide actionable guidance for policymakers and entrepreneurs alike, emphasising the need to tailor strategies that enhance positive TRI dimensions to foster wider adoption of DE. Ultimately, this research enriches the understanding of DE adoption dynamics within emerging markets, offering a nuanced perspective that integrates technological attitudes with organisational and environmental factors, thereby supporting future efforts to accelerate digital transformation among SMEs in Malaysia. © The Author(s) 2025.},
	author_keywords = {Digital entrepreneurship; Small and Medium Sized Enterprises (SMEs); Technology Organisation Environment framework; Technology Readiness Index},
